<?xml version="1.0"?>
<package format="3">
  <name>path_manager</name>
  <version>1.0.0</version>
  <description>Path management package for planning and optimizing trajectories</description>
  <maintainer email="mywww5371@naver.com">limgyeonghun</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>eigen3_cmake_module</depend>
  <depend>eigen</depend>
  <depend>path_optimizer</depend>
  <depend>path_planner</depend>
  <depend>geometry_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>mmp_mission_msgs</depend>
  <depend>mmp_traj_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>grid_map_msgs</depend>
  <depend>yaml-cpp</depend>
  <depend>ament_index_cpp</depend>

  <!-- package://mmp_viz_assets/meshes/* (dynamic-obstacle mesh catalog) -->
  <exec_depend>mmp_viz_assets</exec_depend>
  <!-- rviz_path_manager.launch.py 의 기본 follower (shared_3dof) -->
  <depend>mmp_vehicle_dynamics</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>